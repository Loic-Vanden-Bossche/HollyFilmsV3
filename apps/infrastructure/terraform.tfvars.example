# Copier vers terraform.tfvars (ignoré), puis remplacer les valeurs.
kubeconfig_path = "~/.kube/config"
# kubeconfig_context = "nom-du-contexte-chbrx"
namespace_name = "hollyfilms-v3"
hostname = "hollyfilms-v3.chbrx.com"
jellyfin_url = "https://hollyfilms.chbrx.com"

# Le script deploy fournit automatiquement les images par digest après push.
# Renseigner ces valeurs uniquement pour un plan/apply manuel.
# api_image = "ghcr.io/loic-vanden-bossche/hollyfilms-v3-api:v1.0.0"
# web_image = "ghcr.io/loic-vanden-bossche/hollyfilms-v3-web:v1.0.0"

database_password = ""
jellyfin_api_key = ""
tmdb_api_token = ""

# Services médias existants repris dans ce même état ; ne jamais recréer leurs PVC.
# Les versions et chemins sont dans media-variables.tf.
# Conserver la clé existante du sidecar Jellyfin (stockée dans media.auto.tfvars.json sur la machine de migration).
# jellyfin_home_defaults_api_key = "...clé historique..."
# Instance Seerr consommée par l'API HollyFilms :
# seerr = {
#   url = "https://seerr.chbrx.com"
#   api_key = "...clé serveur Seerr..."
# }

# Garder exactement la clé existante en cas de reprise d'une base SSO !
# google = {
#   client_id = "...apps.googleusercontent.com"
#   client_secret = "..."
#   password_key = "...32 octets en base64..."
# }
# ghcr_credentials = {
#   username = "Loic-Vanden-Bossche"
#   token = "...jeton read:packages..."
# }

# Sur une installation migrée depuis PostgreSQL 17, conserver le volume historique :
# database_retain_legacy_volume = true
# database_major_version = 18
