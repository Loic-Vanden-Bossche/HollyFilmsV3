worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  sendfile on;
  server_tokens off;
  # Tokens may appear in video and WebSocket query strings.
  access_log off;
  client_body_temp_path /tmp/client_temp;
  proxy_temp_path /tmp/proxy_temp;
  fastcgi_temp_path /tmp/fastcgi_temp;
  uwsgi_temp_path /tmp/uwsgi_temp;
  scgi_temp_path /tmp/scgi_temp;
  resolver ${RESOLVERS} valid=30s ipv6=off;
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }
  map $http_x_forwarded_proto $forwarded_proto { default $scheme; https https; }
  # The only public entry is the trusted ingress, which overwrites X-Forwarded-For.
  map $http_x_forwarded_for $client_chain { default $http_x_forwarded_for; '' $remote_addr; }
  map $request_uri $jellyfin_request { ~^/jellyfin(?<jf_path>/.*)$ $jf_path; default /; }
  server {
    listen 8080;
    absolute_redirect off;
    root /usr/share/nginx/html;
    client_max_body_size 100m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    location = /healthz { access_log off; return 200 'ok'; }
    location = /api { return 308 /api/; }
    location /api/ {
      proxy_pass http://127.0.0.1:3000;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      proxy_set_header X-Forwarded-For $client_chain;
      proxy_set_header Connection '';
      proxy_buffering off;
      proxy_read_timeout 90s;
    }
    # HollyFilms uses the API and streams. Jellyfin's own web client has a separate ingress.
    location = /jellyfin { return 404; }
    location ~* ^/jellyfin/(?:web(?:/|$)|$) { return 404; }
    location /jellyfin/ {
      proxy_pass ${JELLYFIN_URL}$jellyfin_request;
      proxy_http_version 1.1;
      proxy_ssl_server_name on;
      proxy_ssl_verify on;
      proxy_ssl_verify_depth 4;
      proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
      proxy_set_header Host $proxy_host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      proxy_set_header X-Forwarded-For $client_chain;
      proxy_buffering off;
      proxy_request_buffering off;
      proxy_cache off;
      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;
    }
    location /assets/ {
      gzip_static on;
      gzip_vary on;
      gzip_proxied any;
      try_files $uri =404;
      expires 1y;
      add_header Cache-Control 'public, immutable';
    }
    location = /index.html {
      add_header Cache-Control 'no-store';
      add_header Referrer-Policy no-referrer always;
    }
    location = /sw.js {
      try_files $uri =404;
      add_header Cache-Control 'no-cache';
      add_header X-Content-Type-Options nosniff always;
    }
    location = /manifest.webmanifest {
      types { application/manifest+json webmanifest; }
      try_files $uri =404;
      add_header Cache-Control 'no-cache';
    }
    location /pwa/ { try_files $uri =404; }
    location / { try_files $uri $uri/ /index.html; }
  }
}
