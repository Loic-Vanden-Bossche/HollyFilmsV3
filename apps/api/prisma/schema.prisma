generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum RegistrationMethod {
  PASSWORD
  GOOGLE
}

enum RegistrationStatus {
  PENDING
  PROVISIONING
  AWAITING_PASSWORD
  ACTIVE
  REJECTED
}

model Registration {
  id                String             @id @default(uuid()) @db.Uuid
  method            RegistrationMethod
  status            RegistrationStatus @default(PENDING)
  username          String
  usernameKey       String             @unique
  technicalName     String             @unique
  googleIssuer      String?
  googleSubject     String?
  googleEmail       String?
  passwordHash      String?
  technicalPassword String?
  jellyfinId        String?            @unique
  decidedBy         String?
  decidedAt         DateTime?
  lastError         String?
  createdAt         DateTime           @default(now())
  flows             GoogleFlow[]

  @@unique([googleIssuer, googleSubject])
  @@index([status, createdAt])
}

model GoogleFlow {
  id             String        @id
  state          String
  nonce          String
  verifier       String
  expiresAt      DateTime
  callbackUsed   Boolean       @default(false)
  registrationId String?       @db.Uuid
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model MediaReview {
  id        String   @id @default(uuid()) @db.Uuid
  itemId    String
  userId    String
  author    String
  content   String
  rating    Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemId, userId])
  @@index([itemId, createdAt])
}
