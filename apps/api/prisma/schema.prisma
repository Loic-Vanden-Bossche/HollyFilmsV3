model SubtitleTiming {
  userId      String
  fingerprint String
  revision    Int
  manualMs    Int
  scale       Float?
  shiftMs     Int?
  updatedAt   DateTime @updatedAt

  @@id([userId, fingerprint])
}

model SubtitleAnalysis {
  id               String   @id @default(uuid())
  userId           String
  fingerprint      String
  engine           String
  stage            String
  processedSeconds Int      @default(0)
  failureCode      String?
  scale            Float?
  shiftMs          Int?
  updatedAt        DateTime @updatedAt

  @@unique([userId, fingerprint, engine])
  @@index([stage, updatedAt])
}

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum RegistrationMethod {
  PASSWORD
  GOOGLE
}

enum RegistrationStatus {
  PENDING
  PROVISIONING
  AWAITING_PASSWORD
  ACTIVE
  REJECTED
}

model Registration {
  id                String             @id @default(uuid()) @db.Uuid
  method            RegistrationMethod
  status            RegistrationStatus @default(PENDING)
  username          String
  usernameKey       String             @unique
  technicalName     String             @unique
  googleIssuer      String?
  googleSubject     String?
  googleEmail       String?
  googlePicture     String?
  passwordHash      String?
  technicalPassword String?
  jellyfinId        String?            @unique
  decidedBy         String?
  decidedAt         DateTime?
  lastError         String?
  createdAt         DateTime           @default(now())
  flows             GoogleFlow[]

  @@unique([googleIssuer, googleSubject])
  @@index([status, createdAt])
}

model GoogleFlow {
  id             String        @id
  state          String
  nonce          String
  verifier       String
  expiresAt      DateTime
  callbackUsed   Boolean       @default(false)
  registrationId String?       @db.Uuid
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model MediaReview {
  id        String   @id @default(uuid()) @db.Uuid
  itemId    String
  userId    String
  author    String
  content   String
  rating    Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemId, userId])
  @@index([itemId, createdAt])
}

enum SubtitleRequestStatus {
  PENDING
  DOWNLOADING
  DOWNLOADED
  REJECTED
  FAILED
}

model SubtitleRequest {
  id            String                @id @default(uuid()) @db.Uuid
  itemId        String
  sourceId      String
  itemName      String
  sourceName    String
  language      String
  requesterId   String
  requesterName String
  activeKey     String?               @unique
  status        SubtitleRequestStatus @default(PENDING)
  remoteId      String?
  baseline      String?
  startedAt     DateTime?
  decidedBy     String?
  decidedByName String?
  decidedAt     DateTime?
  lastError     String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([requesterId, createdAt])
  @@index([status, createdAt])
  @@index([sourceId, status])
}

model Notification {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String
  title      String
  body       String
  url        String
  createdAt  DateTime       @default(now())
  readAt     DateTime?
  deliveries PushDelivery[]

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model PushSubscription {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String
  endpoint   String         @unique
  p256dh     String
  auth       String
  expiresAt  DateTime?
  deliveries PushDelivery[]

  @@index([userId])
}

model PushDelivery {
  notificationId String           @db.Uuid
  subscriptionId String           @db.Uuid
  notification   Notification     @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  subscription   PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  nextAttemptAt  DateTime         @default(now())
  attempts       Int              @default(0)

  @@id([notificationId, subscriptionId])
  @@index([nextAttemptAt])
}
