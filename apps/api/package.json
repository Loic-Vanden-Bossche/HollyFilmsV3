{
  "name": "@hollyfilms/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --input-type=module -e \"import { readConfig } from './src/config.ts'; readConfig(process.env)\" && yarn db:deploy && prisma generate && node --env-file-if-exists=../../.env --watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env src/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test": "prisma generate && node --test tests/accounts.test.ts",
    "test:subtitle-sync": "prisma generate && node tests/requests.e2e.mjs tests/subtitle-sync.test.ts ../../apps/web/tests/subtitle-timing.test.ts",
    "test:media": "prisma generate && node --test tests/media.test.ts",
    "test:requests": "prisma generate && node tests/requests.e2e.mjs",
    "test:subtitles": "prisma generate && node tests/requests.e2e.mjs tests/subtitles.test.ts",
    "test:notifications": "prisma generate && node tests/requests.e2e.mjs tests/notifications.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^10.3.0",
    "@hollyfilms/shared": "workspace:*",
    "@jellyfin/sdk": "^1.0.2",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "axios": "^1.21.1",
    "fastify": "^5.12.8",
    "openid-client": "^6.8.9",
    "pg": "^8.23.1",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "prisma": "^7.10.1",
    "typescript": "~7.0.2"
  }
}
