    "axios": "^1.21.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "flag-icons": "^7.6.0",
    "hls.js": "1.7.4",
    "jassub": "^2.5.37",
    "libbitsub": "1.13.0",
    "lucide-react": "^1.72.0",
    "motion": "^14.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.7",
