    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "addon-storybook-sync": "0.1.0",
    "playwright": "1.66.0-alpha-2026-11-09",
    "shadcn": "^4.23.0",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
