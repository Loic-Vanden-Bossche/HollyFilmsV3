{
  "name": "@hollyfilms/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev --port 6006 --host 127.0.0.1 --no-open --exact-port",
    "build-storybook": "storybook build",
    "test": "node --test tests/*.test.ts",
