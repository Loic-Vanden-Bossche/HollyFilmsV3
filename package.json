{
  "name": "hollyfilms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "docker compose up -d --wait",
    "dev": "concurrently --kill-others --names web,api --prefix-colors cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --strictPort",
    "predev:api": "node --env-file-if-exists=.env --input-type=module -e \"import { readConfig } from './server/config.ts'; readConfig(process.env)\" && npm run db:deploy && prisma generate",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.ts",
    "build": "tsc -b && vite build",
    "build:api": "prisma generate && tsc -p tsconfig.server.json",
    "start:api": "node --env-file-if-exists=.env server/index.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "lint": "oxlint",
    "preview": "vite preview",
    "storybook": "storybook dev --port 6006 --host 127.0.0.1 --no-open --exact-port",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --build-script-name build-storybook",
    "test": "node --test tests/jellyfin.test.ts",
    "test:accounts": "prisma generate && node --test tests/accounts.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^10.3.0",
    "@jellyfin/sdk": "^1.0.2",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "fastify": "^5.12.8",
    "lucide-react": "^1.72.0",
    "motion": "^14.12.0",
    "openid-client": "^6.8.9",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.85",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-mcp": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "addon-storybook-sync": "0.1.0",
    "chromatic": "^18.14.3",
    "concurrently": "^9.2.5",
    "oxlint": "^1.90.0",
    "prettier": "^3.10.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.1",
    "shadcn": "^4.23.0",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "overrides": {
    "@joshwooding/vite-plugin-react-docgen-typescript": {
      "glob": "^14.0.5"
    },
    "@ts-morph/common": {
      "minimatch": "^11.0.8"
    }
  }
}
