{
  "name": "hollyfilms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "deploy": "yarn workspace @hollyfilms/infrastructure deploy",
    "test:infrastructure": "yarn workspace @hollyfilms/infrastructure test",
    "dev": "docker compose up -d --wait && concurrently --kill-others --names web,api --prefix-colors cyan,magenta \"yarn dev:web\" \"yarn dev:api\"",
    "dev:web": "yarn workspace @hollyfilms/web dev",
    "dev:api": "yarn workspace @hollyfilms/api dev",
    "build": "yarn build:web && yarn build:api",
    "build:web": "yarn workspace @hollyfilms/web build",
    "build:api": "yarn workspace @hollyfilms/api build",
    "start:api": "yarn workspace @hollyfilms/api start",
    "db:generate": "yarn workspace @hollyfilms/api db:generate",
    "db:migrate": "yarn workspace @hollyfilms/api db:migrate",
    "db:deploy": "yarn workspace @hollyfilms/api db:deploy",
    "lint": "oxlint",
    "preview": "yarn workspace @hollyfilms/web preview",
    "storybook": "yarn workspace @hollyfilms/web storybook",
    "build-storybook": "yarn workspace @hollyfilms/web build-storybook",
    "test": "yarn workspace @hollyfilms/web test",
    "test:subtitle-sync": "yarn workspace @hollyfilms/api test:subtitle-sync",
    "test:accounts": "yarn workspace @hollyfilms/api test",
    "test:media": "yarn workspace @hollyfilms/api test:media",
    "test:requests": "yarn workspace @hollyfilms/api test:requests",
    "test:subtitles": "yarn workspace @hollyfilms/api test:subtitles",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:player": "yarn workspace @hollyfilms/web test:player"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.85",
    "concurrently": "^9.2.5",
    "oxlint": "^1.90.0",
    "prettier": "^3.10.0",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "resolutions": {
    "@joshwooding/vite-plugin-react-docgen-typescript/glob": "^14.0.5",
    "@ts-morph/common/minimatch": "^11.0.8"
  }
}
